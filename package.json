{
  "name": "pr0",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun --bun turbo run dev",
    "dev:web": "bun --bun turbo run dev --filter=@pr0/web",
    "dev:desktop": "bun run --cwd apps/desktop tauri dev",
    "build": "bun --bun turbo run build",
    "build:desktop": "bun run --cwd apps/desktop tauri build",
    "start": "bun run --cwd apps/web start",
    "typecheck": "bun --bun turbo run typecheck",
    "test": "bun --bun turbo run test",
    "lint": "bun --bun ultracite check",
    "check": "bun --bun ultracite check && bun run check:rust",
    "check:rust": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --check",
    "fix": "bun --bun ultracite fix && bun run fix:rust",
    "fix:rust": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "doctor": "npx react-doctor@latest"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.1.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^20",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-github": "6.1.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-plugin-react-doctor": "^0.9.13",
    "turbo": "^2.11.2",
    "typescript": "^5",
    "ultracite": "7.12.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
