{
  "name": "@pr0/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run docs:prepare && bun --bun next dev --port 3000",
    "build": "bun run docs:prepare && bun run ops:build && bun --bun next build",
    "ops:build": "bun build scripts/accounts.ts scripts/mail-worker.ts --target=bun --conditions=react-server --outdir=.operations",
    "accounts": "bun --conditions=react-server scripts/accounts.ts",
    "mail:worker": "bun --conditions=react-server scripts/mail-worker.ts",
    "docs:prepare": "bun scripts/prepare-docs.ts",
    "start": "bun --bun next start",
    "typecheck": "bun --bun next typegen && bun --bun tsc --noEmit",
    "test": "bun test src",
    "test:accounts": "bun --env-file=tests/compose.env test tests/deployment-integration.test.ts",
    "test:collections": "bun --env-file=tests/social.env tests/collections-runner.ts",
    "test:tags": "bun --env-file=tests/social.env tests/tags-runner.ts",
    "test:prompts": "bun --env-file=tests/social.env tests/prompts-runner.ts",
    "test:prompt-edits": "bun --env-file=tests/social.env tests/prompt-edits-runner.ts",
    "test:prompt-lifecycle": "bun --env-file=tests/social.env tests/prompt-lifecycle-runner.ts",
    "test:prompt-deletion": "bun --env-file=tests/social.env tests/prompt-deletion-runner.ts",
    "test:recovery": "bun --env-file=tests/compose.env test tests/recovery-deployment.test.ts",
    "test:social": "bun --env-file=tests/social.env tests/social-runner.ts",
    "test:email-change": "bun --env-file=tests/social.env tests/email-change-runner.ts",
    "test:login-methods": "bun --env-file=tests/social.env tests/login-methods-runner.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@pr0/api-client": "workspace:*",
    "@pr0/api-contract": "workspace:*",
    "@pr0/prototype-library": "workspace:*",
    "@pr0/ui": "workspace:*",
    "@tanstack/react-query": "^5.103.1",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "next": "16.3.5",
    "nodemailer": "7.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "swagger-ui-dist": "^5.33.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@pr0/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.2",
    "@types/node": "^20",
    "@types/nodemailer": "7.0.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
