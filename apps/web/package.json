{
  "name": "@pr0/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run docs:prepare && bun --bun next dev --port 3000",
    "build": "bun run docs:prepare && bun --bun next build",
    "docs:prepare": "bun scripts/prepare-docs.ts",
    "start": "bun --bun next start",
    "typecheck": "bun --bun next typegen && bun --bun tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@pr0/api-client": "workspace:*",
    "@pr0/api-contract": "workspace:*",
    "@pr0/prototype-library": "workspace:*",
    "@pr0/ui": "workspace:*",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "swagger-ui-dist": "^5.33.0"
  },
  "devDependencies": {
    "@pr0/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
