{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local main-window account commands only. Remote content has no native permissions.",
  "windows": ["main"],
  "permissions": [
    "allow-auth-status",
    "allow-auth-begin",
    "allow-auth-poll",
    "allow-auth-cancel",
    "allow-auth-open-browser",
    "allow-auth-refresh",
    "allow-auth-sign-out",
    "allow-library-status",
    "allow-library-download",
    "allow-library-browse",
    "allow-library-detail"
  ]
}
