# Copy to .env and configure secrets and SMTP before starting accounts.
# See docs/operations/accounts.md. Generate independent random secrets.
PR0_PORT=3000
PR0_BIND_ADDRESS=127.0.0.1
PR0_ORIGIN=http://localhost:3000
POSTGRES_PASSWORD=
DATABASE_URL=postgres://pr0:REPLACE_WITH_URL_ENCODED_PASSWORD@database:5432/pr0
BETTER_AUTH_SECRET=
PR0_MAIL_SECRET=
PR0_REGISTRATION=closed
# Optional social providers; omit client IDs to disable. See docs/social-login.md.
PR0_GOOGLE_CLIENT_ID=
PR0_GOOGLE_CLIENT_SECRET=
PR0_GITHUB_CLIENT_ID=
PR0_GITHUB_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional authenticated ingress. Without it, requests share a conservative IP bucket.
PR0_INGRESS_SECRET=

# Each server secret also supports NAME_FILE=/run/secrets/<mounted-file>.
# Compose secret mounts belong in your local override. PostgreSQL supports POSTGRES_PASSWORD_FILE.

# Additional origins for the public health endpoint. Account routes remain same-origin.
API_ALLOWED_ORIGINS=
