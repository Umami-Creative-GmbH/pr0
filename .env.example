# Copy to .env and configure secrets, SMTP and independent deletion stores.
# Follow docs/operations/self-hosting.md from a clean checkout.
# Build matching versioned application and tools images from the same source.
PR0_IMAGE=pr0-local
PR0_TOOLS_IMAGE=pr0-migrations
PR0_PORT=3000
PR0_BIND_ADDRESS=127.0.0.1
PR0_ORIGIN=http://localhost:3000
POSTGRES_PASSWORD=
DATABASE_URL=postgres://pr0:REPLACE_WITH_URL_ENCODED_PASSWORD@database:5432/pr0
BETTER_AUTH_SECRET=
PR0_MAIL_SECRET=
PR0_REGISTRATION=closed
# Optional social providers; omit client IDs to disable. See docs/social-login.md.
PR0_GOOGLE_CLIENT_ID=
PR0_GOOGLE_CLIENT_SECRET=
PR0_GITHUB_CLIENT_ID=
PR0_GITHUB_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional authenticated ingress. Without it, requests share a conservative IP bucket.
PR0_INGRESS_SECRET=
PR0_METRICS_SECRET=
# See docs/operations/service-health.md for shared limits, storage/backup observations,
# private metrics, and the external authenticated availability probe.

# Each server secret also supports NAME_FILE=/run/secrets/<mounted-file>.
# Compose secret mounts belong in your local override. PostgreSQL supports POSTGRES_PASSWORD_FILE.
# Copy compose.secrets.example.yaml to compose.override.yaml for mounted secrets.
# Leave each corresponding plaintext value empty when using NAME_FILE.
# POSTGRES_PASSWORD_FILE=/run/secrets/POSTGRES_PASSWORD
# DATABASE_URL_FILE=/run/secrets/DATABASE_URL
# BETTER_AUTH_SECRET_FILE=/run/secrets/BETTER_AUTH_SECRET
# PR0_MAIL_SECRET_FILE=/run/secrets/PR0_MAIL_SECRET
# PR0_LEDGER_A_URL_FILE=/run/secrets/PR0_LEDGER_A_URL
# PR0_LEDGER_B_URL_FILE=/run/secrets/PR0_LEDGER_B_URL
# SMTP_PASSWORD_FILE=/run/secrets/SMTP_PASSWORD
# PR0_INGRESS_SECRET_FILE=/run/secrets/PR0_INGRESS_SECRET
# PR0_METRICS_SECRET_FILE=/run/secrets/PR0_METRICS_SECRET

# Additional origins for the public health endpoint. Account routes remain same-origin.
API_ALLOWED_ORIGINS=

# Encrypted ordinary backups: dedicated off-server filesystem, separate secret,
# and immutable application release. See docs/operations/backup-restore.md.
PR0_BACKUP_MOUNT=
PR0_BACKUP_KEY_PATH=
PR0_BACKUP_RELEASE=
# Independent current deletion stores are never restored from ordinary backups.
PR0_LEDGER_A_URL=
PR0_LEDGER_B_URL=
