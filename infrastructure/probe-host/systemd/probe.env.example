# /etc/pr0-probe/probe.env — non-secret settings for pr0-probe.service.
# Secrets never go here: they are files under /etc/pr0-probe/credentials/ (see the unit).
PR0_PROBE_ORIGIN=https://pr0.umami-creative.app
# UUID of the canary account's prompt titled pr0-availability-canary.
PR0_PROBE_PROMPT_ID=00000000-0000-0000-0000-000000000000
PR0_ALERT_EMAIL_FROM=pr0 probe <probe@umami-creative.app>
# Comma-separated recipients: the operator, plus a backup person if one exists.
PR0_ALERT_EMAIL_TO=operator@umami-creative.app
