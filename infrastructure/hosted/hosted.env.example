# Hosted pr0 configuration. Copy to /opt/pr0/.env on the Coolify server (owner root, mode 0600).
# Holds no secrets: each secret is a file in PR0_SECRET_DIRECTORY, listed below.
# See docs/operations/hosted.md.

# Fixed project name and the hosted overlay. Renaming the project selects different volumes.
COMPOSE_PROJECT_NAME=pr0
COMPOSE_FILE=compose.yaml:compose.hosted.yaml

# Release identity. infrastructure/hosted/redeploy.ts rewrites these four lines for each
# deployed commit (PR0_IMAGE_NAME:<commit>, PR0_IMAGE_NAME-tools:<commit>, ...).
# For the first deployment, set them by hand to the checked-out commit.
PR0_IMAGE_NAME=pr0
PR0_IMAGE=pr0:REPLACE_WITH_COMMIT
PR0_TOOLS_IMAGE=pr0-tools:REPLACE_WITH_COMMIT
PR0_INGRESS_IMAGE=pr0-ingress:REPLACE_WITH_COMMIT
PR0_BACKUP_RELEASE=pr0@REPLACE_WITH_FULL_COMMIT

# Public origin. The web app is at the root; /update stays a separate Coolify resource.
PR0_ORIGIN=https://pr0.umami-creative.app
PR0_PUBLIC_HOST=pr0.umami-creative.app
# allowlist until the release act; then open.
PR0_REGISTRATION=allowlist
# The operator's legal pages (absolute HTTPS URLs), required for the hosted launch.
# Shown on web sign-in, sign-up and the footer, and sent to desktops through discovery.
# An invalid value stops web at startup. See docs/operations/self-hosting.md.
PR0_IMPRESSUM_URL=REPLACE_WITH_IMPRESSUM_URL
PR0_PRIVACY_URL=REPLACE_WITH_PRIVACY_POLICY_URL
PR0_TERMS_URL=REPLACE_WITH_TERMS_URL

# Coolify's Traefik: its network, entry points and certificate resolver.
PR0_PROXY_NETWORK=coolify
PR0_TRAEFIK_HTTP_ENTRYPOINT=http
PR0_TRAEFIK_HTTPS_ENTRYPOINT=https
PR0_TRAEFIK_CERT_RESOLVER=letsencrypt
# Subnet of PR0_PROXY_NETWORK:
#   docker network inspect coolify --format '{{range .IPAM.Config}}{{.Subnet}} {{end}}'
PR0_INGRESS_TRUSTED_PROXIES=REPLACE_WITH_COOLIFY_SUBNET
# Probe host's public address as Traefik sees it (metrics route only).
PR0_INGRESS_METRICS_ALLOW=REPLACE_WITH_PROBE_HOST_ADDRESS

# Email (Brevo). SMTP_PASSWORD is a secret file.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=REPLACE_WITH_BREVO_SMTP_LOGIN
SMTP_FROM=no-reply@umami-creative.app

# OAuth client IDs are not secret; the client secrets are files. Leave an ID empty to
# disable that provider; its secret file must still exist (any placeholder content).
PR0_GOOGLE_CLIENT_ID=
PR0_GITHUB_CLIENT_ID=

# Secret files, outside the checkout: directory 0700 owned by the operator, files 0444,
# readable by UID 1000 (Bun services, backup) and the postgres UID (database, tools).
# POSTGRES_PASSWORD        strong application database password
# DATABASE_URL             postgres://pr0:<URL-encoded-password>@database:5432/pr0
# BETTER_AUTH_SECRET       random, at least 32 characters; never rotated casually
# PR0_MAIL_SECRET          random, at least 32 characters, independent of the above
# PR0_LEDGER_A_URL         ledger A, see "Ledger URLs" below
# PR0_LEDGER_B_URL         ledger B, see "Ledger URLs" below
# SMTP_PASSWORD            Brevo SMTP key
# PR0_INGRESS_SECRET       openssl rand -hex 32; shared by web and ingress
# PR0_METRICS_SECRET       openssl rand -hex 32; also on the probe host
# PR0_GOOGLE_CLIENT_SECRET production Google OAuth client secret
# PR0_GITHUB_CLIENT_SECRET production GitHub OAuth app secret
# PR0_CANARY_COOKIE        the canary's Cookie header value, used by redeploy checks
PR0_SECRET_DIRECTORY=/etc/pr0/secrets
POSTGRES_PASSWORD_FILE=/run/secrets/POSTGRES_PASSWORD
DATABASE_URL_FILE=/run/secrets/DATABASE_URL
BETTER_AUTH_SECRET_FILE=/run/secrets/BETTER_AUTH_SECRET
PR0_MAIL_SECRET_FILE=/run/secrets/PR0_MAIL_SECRET
PR0_LEDGER_A_URL_FILE=/run/secrets/PR0_LEDGER_A_URL
PR0_LEDGER_B_URL_FILE=/run/secrets/PR0_LEDGER_B_URL
SMTP_PASSWORD_FILE=/run/secrets/SMTP_PASSWORD
PR0_INGRESS_SECRET_FILE=/run/secrets/PR0_INGRESS_SECRET
PR0_METRICS_SECRET_FILE=/run/secrets/PR0_METRICS_SECRET
PR0_GOOGLE_CLIENT_SECRET_FILE=/run/secrets/PR0_GOOGLE_CLIENT_SECRET
PR0_GITHUB_CLIENT_SECRET_FILE=/run/secrets/PR0_GITHUB_CLIENT_SECRET

# Ledger URLs (secret files above): two PostgreSQL 17 hosts in independent failure domains,
#   postgres://<role>:<URL-encoded-password>@<ledger-host>:5432/<database>?sslmode=verify-full
# For `deletions initialize` only, the files hold the administrative role. Before web and
# mail first start, replace them with the restricted append-only runtime role.
# See docs/operations/account-deletion.md#independent-storage-configuration.

# Canary prompt checked by the redeploy script (same as the probe host's PR0_PROBE_PROMPT_ID).
PR0_CANARY_PROMPT_ID=REPLACE_WITH_CANARY_PROMPT_UUID

# Encrypted off-server backups: the Storage Box mount (owned by UID 1000) and the backup key
# file (readable by UID 1000, kept in the vault). PR0_BACKUP_RELEASE is set above.
PR0_BACKUP_MOUNT=/mnt/pr0-backups
PR0_BACKUP_KEY_PATH=/etc/pr0/backup-key
